{
	"name": "worker-platform",
	"description": "Cloudflare Worker platform with D1 storage, KV namespace, OpenCode, Codex, FastMCP, and OpenAuth integration.",
	"cloudflare": {
		"label": "Worker Platform with AI Agent SDKs",
		"products": [
			"Workers",
			"Workers for Platforms",
			"D1",
			"KV"
		],
		"categories": [],
		"publish": true,
		"bindings": {
			"READONLY": {
				"description": "If `true`, disables new uploads. If `false`, allows new uploads."
			}
		}
	},
	"dependencies": {
		"cloudflare": "5.2.0",
		"hono": "^4.8.9",
		"@openauthjs/openauth": "^0.4.3",
		"valibot": "^1.2.0",
		"@anthropic-ai/sdk": "^0.39.0",
		"@modelcontextprotocol/sdk": "^1.25.0",
		"ai": "^5.0.0-beta.34",
		"zod": "^3.24.0"
	},
	"devDependencies": {
		"tsx": "4.21.0",
		"typescript": "5.9.3",
		"wrangler": "4.56.0",
		"@cloudflare/workers-types": "^4.20250312.0"
	},
	"private": true,
	"scripts": {
		"deploy": "npm run deploy:wfp && wrangler deploy",
		"deploy:wfp": "tsx scripts/deploy-wfp.ts",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"db:migrate": "wrangler d1 execute worker-platform-db --local --file=./migrations/0001_init.sql",
		"db:migrate:remote": "wrangler d1 execute worker-platform-db --remote --file=./migrations/0001_init.sql"
	}
}
